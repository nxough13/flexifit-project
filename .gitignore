images/1*.png

# Keep the upload directories themselves
!uploads/payment_proofs/.gitkeep
!uploads/plans/.gitkeep
!uploads/trainers/.gitkeep
!admin/uploads/.gitkeep
!member/uploads/.gitkeep

# Composer dependencies — regenerate with `composer install`
vendor/

